{
    "name": "reactive-leds",
    "private": true,
    "license": "GPL-3.0-only",
    "scripts": {
        "prepare": "npm run build --workspace=shared",
        "test": "npm run build --workspace=shared && npm test --workspaces",
        "build:site": "npm run build --workspace=shared && npm run build --workspace=client && node build-site.mjs"
    },
    "workspaces": [
        "shared",
        "client",
        "cli"
    ],
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/jest": "^30.0.0",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "typescript": "^5.4.5"
    },
    "jest": {
        "preset": "ts-jest",
        "testMatch": [
            "**/__tests__/**/*.ts",
            "**/?(*.)+(spec|test).ts"
        ],
        "moduleNameMapper": {
            "\\.worker$": "<rootDir>/client/tests/__mocks__/workerMock.ts"
        }
    }
}
