{
	"compilerOptions": {
		"baseUrl": ".",
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"isolatedModules": false,
		"useDefineForClassFields": false,
		"declaration": true,
		"types": ["node", "jest"],
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"lib": ["DOM", "ESNext"],
		"resolveJsonModule": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build", "dist"]
}
