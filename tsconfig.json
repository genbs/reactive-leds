// gydra-led/tsconfig.json
{
	"compilerOptions": {
		"target": "es2021",
		"module": "commonjs",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@leds/shared": ["./shared/index"]
		},
		"types": ["jest"]
	},
	"exclude": ["node_modules", "**/node_modules", "**/dist"],
	"references": [{ "path": "./shared" }, { "path": "./client" }, { "path": "./server" }]
}
