{
    "name": "@reactive-leds/client",
    "version": "1.0.0",
    "description": "Browser JavaScript client for realtime LED control over WebSocket. Bridges the reactive-leds UDP protocol to browser applications via a local proxy.",
    "keywords": [
        "led",
        "esp32",
        "ws2812",
        "websocket",
        "live-coding",
        "visuals",
        "browser"
    ],
    "author": "Gennaro Bosone",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/genbs/reactive-leds.git",
        "directory": "client"
    },
    "homepage": "https://github.com/genbs/reactive-leds/tree/master/client#readme",
    "scripts": {
        "build": "esbuild src/main.ts --bundle --format=esm --outfile=build/reactive-leds.js && esbuild src/daemon.worker.ts --bundle --format=esm --outfile=build/daemon.worker.js",
        "test": "jest"
    },
    "license": "MIT",
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "esbuild": "^0.25.0",
        "ts-jest": "^29.3.2",
        "typescript": "^5.4.5"
    },
    "jest": {
        "preset": "ts-jest",
        "moduleNameMapper": {
            "\\.worker$": "<rootDir>/tests/__mocks__/workerMock.ts"
        }
    }
}