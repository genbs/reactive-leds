{
    "name": "@reactive-leds/client",
    "version": "1.0.0",
    "description": "Browser JavaScript client for realtime LED control over WebSocket. Bridges the reactive-leds UDP protocol to browser applications via a local proxy.",
    "keywords": [
        "led",
        "esp32",
        "ws2812",
        "websocket",
        "live-coding",
        "visuals",
        "browser"
    ],
    "author": "Gennaro Bosone",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/genbs/reactive-leds.git",
        "directory": "client"
    },
    "homepage": "https://github.com/genbs/reactive-leds/tree/master/client#readme",
    "main": "build/reactive-leds.umd.js",
    "module": "build/reactive-leds.js",
    "types": "build/reactive-leds.d.ts",
    "exports": {
        ".": {
            "types": "./build/reactive-leds.d.ts",
            "import": "./build/reactive-leds.js",
            "require": "./build/reactive-leds.umd.js",
            "default": "./build/reactive-leds.js"
        }
    },
    "files": [
        "build/",
        "README.md",
        "README-it.md"
    ],
    "scripts": {
        "build": "node build.mjs",
        "prepare": "npm run build",
        "test": "jest"
    },
    "license": "MIT",
    "devDependencies": {
        "@jest/globals": "^29.7.0",
        "dts-bundle-generator": "^9.5.1",
        "esbuild": "^0.25.0",
        "ts-jest": "^29.3.2",
        "typescript": "^5.4.5"
    },
    "jest": {
        "preset": "ts-jest",
        "moduleNameMapper": {
            "\\.worker$": "<rootDir>/tests/__mocks__/workerMock.ts"
        }
    }
}
