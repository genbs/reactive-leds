{
	"extends": "../tsconfig.json",
	"compilerOptions": {
"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": false,
		"useDefineForClassFields": false,
		"types": ["node", "jest"],
		"allowSyntheticDefaultImports": true,
		"lib": ["DOM", "ESNext"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "build", "dist"]
}
