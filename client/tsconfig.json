{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "ESNext",
		"jsx": "react-jsx",
		"target": "ESNext",
		"moduleResolution": "node",
		"isolatedModules": false,
		"useDefineForClassFields": false,
		"declaration": true,
		"types": ["node", "jest"],
		"allowSyntheticDefaultImports": true,
		"lib": ["DOM", "ESNext"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "build", "dist"],
	"references": [{ "path": "../shared" }]
}
