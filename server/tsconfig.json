{
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"module": "CommonJS",
		"jsx": "react-jsx",
		"target": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"isolatedModules": false,
		"useDefineForClassFields": false,
		"declaration": true,
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"lib": ["DOM", "ESNext"],
		"resolveJsonModule": true,
		"paths": {}
	},
	"exclude": ["node_modules"]
}
