# Project-specific overrides for reactive-leds firmware.
# ESP-IDF generates the full sdkconfig from this file + IDF defaults at build time.
# Keep this file minimal — only entries that differ from IDF defaults belong here.

# --- Target hardware ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- Partition table (see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Bluetooth ---
# BLE 4.2 features required for the provisioning GATT server.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# --- lwIP / UDP ---
# Small UDP receive mailbox (6 slots). When full the kernel drops new arrivals
# (drop-tail), so recvfrom always returns the FRESHEST frame — minimal latency,
# which is what a 60 fps real-time animation wants. A larger mailbox would only
# buffer stale frames to be shown late.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_MAX_UDP_PCBS=32
CONFIG_LWIP_TCPIP_TASK_PRIO=1
CONFIG_LWIP_LOCAL_HOSTNAME="esp32-X"

# --- FreeRTOS ---
# 1000 Hz tick (default 100 Hz) gives vTaskDelay 1 ms granularity, improving
# responsiveness of the 2 ms protocol polling loop.
CONFIG_FREERTOS_HZ=1000

# --- Device configuration (overridable via menuconfig "Device configuration") ---
CONFIG_LED_PIN=18
CONFIG_NUM_LEDS=16
CONFIG_PORT=4210

# --- Production (performance-first) ---
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- RMT + DMA in IRAM ---
# The LED strip uses RMT with DMA (leds.c: flags.with_dma). Keeping the RMT and
# GDMA ISRs IRAM-safe — and the encoder callbacks marked IRAM_ATTR — prevents a
# crash if a flash-cache-disable window (e.g. an NVS write) overlaps a transfer.
CONFIG_RMT_ISR_IRAM_SAFE=y
CONFIG_GDMA_ISR_IRAM_SAFE=y

# --- Task pinning ---
# Isolate the LED render pipeline (protocol task, core 1) from the WiFi/lwIP
# stack (core 0). Clean separation of concerns.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
